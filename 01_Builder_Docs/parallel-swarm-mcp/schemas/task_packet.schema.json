{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parallel task packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "run_id", "requirement_ids", "title", "objective", "owner_role_key", "dependencies", "status"],
  "properties": {
    "packet_id": {"type": "string"},
    "run_id": {"type": "string"},
    "requirement_ids": {"type": "array", "items": {"type": "string"}},
    "title": {"type": "string"},
    "objective": {"type": "string"},
    "owner_role_key": {"type": "string"},
    "assigned_agent_id": {"type": ["string", "null"]},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "resource_locks": {"type": "array", "items": {"type": "string"}},
    "github_binding": {"type": ["object", "null"]},
    "vercel_binding": {"type": ["object", "null"]},
    "context_snapshot_id": {"type": "string"},
    "inputs": {"type": "object"},
    "expected_outputs": {"type": "array", "items": {"type": "string"}},
    "acceptance_tests": {"type": "array", "items": {"type": "string"}},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "risk_class": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "attempt": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1},
    "status": {"enum": ["DRAFT", "BLOCKED", "READY", "CLAIMED", "RUNNING", "SUCCEEDED", "FAILED", "RETRY_READY", "TERMINAL_FAILED", "CANCELLED"]},
    "result_id": {"type": ["string", "null"]}
  }
}